    "bbox": [
      76.58,
      337.49,
      538.0,
      350.45
    ],
    "text": "The instant application for revision has been filed to set aside the order of the learned",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.960000038146973
    ]
  },
