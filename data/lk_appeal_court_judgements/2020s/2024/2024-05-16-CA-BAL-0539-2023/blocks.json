      "Times New Roman"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.02,
      412.74,
      114.02,
      426.02
    ],
    "text": "ailment.",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.02,
      443.46,
      526.07,
      456.74
    ],
    "text": "According to the page number \u201858\u2019 of the High Court case record, this suspect has no",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      12.0
    ]
