      "Times New Roman"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      72.02,
      425.1,
      410.02,
      438.38
    ],
    "text": "subjected to a body search and the Police found the illegal substance.",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      72.02,
      455.7,
      526.14,
      468.98
    ],
    "text": "The petitioner has made this application before us under section 83 of the Poisons, Opium",
