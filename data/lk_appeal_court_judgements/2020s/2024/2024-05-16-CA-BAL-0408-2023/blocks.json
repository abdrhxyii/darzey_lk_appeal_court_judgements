    "bbox": [
      108.02,
      473.46,
      526.08,
      486.74
    ],
    "text": "unfortunately suspect was caught in the raid that took place at Jayasiri\u201fs house while",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      108.02,
      494.22,
      219.05,
      507.5
    ],
    "text": "she was in that house.",
    "fonts": [
      "Times New Roman"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
