  },
  {
    "page_number": 2,
    "bbox": [
      93.73,
      381.55,
      537.81,
      395.22
    ],
    "text": "No. 14 of 1935. The 2nd, 3rd, 5th and 6th Petitioners are respectively the Presidents and",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      7.507699966430664,
      11.289799690246582
    ]
  },
  {
    "page_number": 2,
