    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.0,
      266.16,
      359.11,
      278.16
    ],
    "text": "(f) such other form of remuneration as may be prescribed;",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.0,
      298.14,
      404.05,
      310.14
    ],
    "text": "According to Section 20 of the Gratuity Act \"wage or salary\" means:",
