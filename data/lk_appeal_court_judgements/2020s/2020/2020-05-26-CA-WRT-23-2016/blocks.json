    ],
    "text": "(a) the basic or consolidated wage or salary;",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.0,
      362.1,
      477.73,
      374.1
    ],
    "text": "(b) cost of living allowance, special living allowance or other similar allowance; and",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.0,
      394.08,
