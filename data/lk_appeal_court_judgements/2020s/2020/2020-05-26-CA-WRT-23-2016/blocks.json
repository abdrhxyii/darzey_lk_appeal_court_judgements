      214.26
    ],
    "text": "(d) cash value of any cooked or uncooked food provided by the employer;",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      72.0,
