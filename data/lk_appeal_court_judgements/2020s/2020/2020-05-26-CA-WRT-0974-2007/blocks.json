    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 6,
    "bbox": [
      108.0,
      563.88,
      542.71,
      575.88
    ],
    "text": "cannot smuggle that question into a writ application in which relief is claimed on",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
