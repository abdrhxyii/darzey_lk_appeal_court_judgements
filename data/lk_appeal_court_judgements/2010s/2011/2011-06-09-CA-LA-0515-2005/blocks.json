    ],
    "text": "49 N.L.R. 49 Tambiah J held \"that both on principle and on authority it seems to us that",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      77.76,
      219.82,
      515.21,
      235.96
    ],
