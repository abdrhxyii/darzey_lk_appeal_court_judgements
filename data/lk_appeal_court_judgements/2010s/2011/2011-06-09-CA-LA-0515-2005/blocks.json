      131.65
    ],
    "text": "vs. Naina Marikkar (1912) 6 S.C.C. 79, Suhuda vs. Sovena (1913) 1 Bal Notes 87., Setua",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      76.78,
      137.06,
      514.58,
