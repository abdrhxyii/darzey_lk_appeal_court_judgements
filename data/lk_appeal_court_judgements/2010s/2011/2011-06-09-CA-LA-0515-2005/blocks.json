    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      77.15,
      157.7,
      515.02,
      173.18
    ],
    "text": "(1934) 36 N.L.R. 108, Tilekeratne vs. Keerthiratne (1935) 14 C.L.R. 412, Sellaman",
