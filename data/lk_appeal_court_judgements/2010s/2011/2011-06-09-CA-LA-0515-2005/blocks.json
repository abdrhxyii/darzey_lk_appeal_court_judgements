      "Times-Roman"
    ],
    "sizes": [
      11.574421882629395,
      11.600000381469727
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      77.26,
      178.57,
      514.79,
      194.05
    ],
    "text": "Achie vs. Palavasam (1939) 41 N.L.R. 186, Chittambaram Chettiar vs Fernando (1947)",
