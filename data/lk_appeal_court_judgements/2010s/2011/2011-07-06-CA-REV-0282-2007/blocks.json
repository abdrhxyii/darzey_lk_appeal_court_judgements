    "bbox": [
      94.02,
      300.01,
      531.42,
      315.61
    ],
    "text": "Judge had confirmed the restoration of possession of the petitioner. It is this order the",
    "fonts": [
      "Helvetica",
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727,
      11.967391967773438,
      12.18452262878418
