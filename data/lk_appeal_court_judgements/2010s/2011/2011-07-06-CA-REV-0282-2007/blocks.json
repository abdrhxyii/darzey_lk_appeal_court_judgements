      12.12473201751709,
      12.18452262878418
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      96.17,
      520.57,
      534.0,
      536.05
    ],
    "text": "In terms of section 52 (2) (a) if he seeks to evict any person in occupation of a land or a",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727,
      12.051368713378906,
      12.316285133361816,
      12.476532936096191
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      96.21,
      541.21,
      534.32,
      556.69
    ],
