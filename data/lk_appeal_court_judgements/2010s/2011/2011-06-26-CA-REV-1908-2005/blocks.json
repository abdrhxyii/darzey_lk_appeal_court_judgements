    ]
  },
  {
    "page_number": 3,
    "bbox": [
      78.94,
      280.27,
      515.1,
      296.14
    ],
    "text": "An appeal filed by the respondent was rejected. Thereafter the respondent filed an",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.199999809265137,
