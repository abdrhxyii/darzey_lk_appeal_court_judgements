    ]
  },
  {
    "page_number": 3,
    "bbox": [
      78.48,
      218.1,
      517.01,
      233.98
    ],
    "text": "not served on the respondent. The inquiry was concluded with the submissions of",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.899999618530273,
      12.206210136413574
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      78.6,
      238.74,
      424.54,
