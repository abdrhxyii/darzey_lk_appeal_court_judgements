      "Helvetica",
      "Times-Roman"
    ],
    "sizes": [
      8.100000381469727,
      11.899999618530273
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      75.5,
      531.3,
      511.74,
      547.18
    ],
    "text": "is not entitled to re-agitate on the same matter. In his petition dated 29.11.2002 the 4th",
    "fonts": [
      "Helvetica",
      "Times-Roman"
    ],
    "sizes": [
      8.100000381469727,
      11.899999618530273
    ]
  },
  {
    "page_number": 1,
    "bbox": [
