      "Times-Roman"
    ],
    "sizes": [
      11.699999809265137,
      11.899999618530273
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      73.9,
      386.35,
      508.08,
      402.23
    ],
    "text": "the case was fixed for trial and this objection was taken at the commencement of the trial.",
