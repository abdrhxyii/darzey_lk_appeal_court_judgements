    ]
  },
  {
    "page_number": 1,
    "bbox": [
      74.63,
      448.75,
      511.78,
      464.62
    ],
    "text": "reason that the court had already inquired in to this matter and made an order on",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.899999618530273
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      75.43,
      469.38,
      511.55,
      485.25
    ],
