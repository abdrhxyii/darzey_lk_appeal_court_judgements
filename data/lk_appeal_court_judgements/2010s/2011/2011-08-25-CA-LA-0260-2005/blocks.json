      "Helvetica",
      "Times-Roman"
    ],
    "sizes": [
      8.100000381469727,
      11.899999618530273
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      75.49,
      510.41,
      512.28,
      526.29
    ],
    "text": "learned Judge stated that the 4th defendant is bound by the order made on 15.2.2001 and",
