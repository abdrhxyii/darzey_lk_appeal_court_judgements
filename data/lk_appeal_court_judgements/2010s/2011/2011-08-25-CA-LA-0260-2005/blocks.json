    "sizes": [
      11.899999618530273
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      76.05,
      593.45,
      512.84,
      609.33
    ],
    "text": "the Court of Appeal the 4th defendant does not disclose the fact that this matter was once",
