    ]
  },
  {
    "page_number": 4,
    "bbox": [
      125.44,
      132.88,
      525.87,
      148.49
    ],
    "text": "In Saravanamuttu Vs. De Mel, 49 N.L.R 529, Dias, J held that in business",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.699999809265137
