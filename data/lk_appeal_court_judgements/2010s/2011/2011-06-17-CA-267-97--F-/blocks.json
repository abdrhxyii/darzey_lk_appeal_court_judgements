    "bbox": [
      89.74,
      153.52,
      525.62,
      169.13
    ],
    "text": "matters, if a person states in a letter to another that a certain state of facts exists, the",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.690596580505371,
      11.699999809265137,
      12.177169799804688,
