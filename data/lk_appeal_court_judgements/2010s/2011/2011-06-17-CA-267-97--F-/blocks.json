    "bbox": [
      125.9,
      70.71,
      528.29,
      86.32
    ],
    "text": "letter, but proceeds with the negotiations, he must be taken to admit the truth of",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.690095901489258,
      11.699999809265137,
      12.103201866149902
    ]
