    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.699999809265137,
      11.996736526489258
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      89.67,
      195.03,
      525.74,
      210.64
    ],
    "text": "dispute assertions Otherwise, the silence of the letter amounts to an admission of the truth",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.699999809265137,
      12.103201866149902,
      12.236929893493652
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      89.64,
      215.68,
      283.58,
      231.29
    ],
