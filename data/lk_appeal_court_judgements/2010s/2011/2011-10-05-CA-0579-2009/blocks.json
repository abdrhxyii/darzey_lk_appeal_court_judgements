      12.560029029846191,
      12.699999809265137,
      12.850656509399414
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      91.86,
      671.83,
      513.2,
      688.77
    ],
    "text": "Respondent as the arbitrator. The dispute referred for arbitration is as follows:",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      12.699999809265137
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      521.14,
      32.5,
