      "Times-Roman"
    ],
    "sizes": [
      12.699999809265137
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      91.84,
      400.14,
      527.79,
      417.09
    ],
    "text": "Petitioner is justified. The Petitioner challenged this order before the High Court",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      12.699999809265137,
      12.74686336517334
    ]
  },
