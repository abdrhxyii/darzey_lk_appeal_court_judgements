    "page_number": 1,
    "bbox": [
      92.04,
      430.37,
      526.46,
      447.32
    ],
    "text": "of the Western Province. The High Court in its judgment dated 13.02.1998",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      12.699999809265137,
      12.705948829650879,
      12.713692665100098,
      12.72213077545166,
      12.725174903869629
