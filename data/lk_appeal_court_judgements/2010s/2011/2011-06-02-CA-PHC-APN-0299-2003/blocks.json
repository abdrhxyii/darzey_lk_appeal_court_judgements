    ]
  },
  {
    "page_number": 2,
    "bbox": [
      90.42,
      189.71,
      525.73,
      208.12
    ],
    "text": "Martin Vs Wijewardene (supra). The Supreme Court in the said case held:",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      13.300000190734863,
