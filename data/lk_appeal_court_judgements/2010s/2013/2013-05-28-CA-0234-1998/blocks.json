      14.265209197998047
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      65.88,
      200.02,
      534.77,
      218.43
    ],
    "text": "learned District Judge when he came to his findings as to the identity of the land",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      13.770719528198242,
      13.800000190734863,
      14.265209197998047
    ]
