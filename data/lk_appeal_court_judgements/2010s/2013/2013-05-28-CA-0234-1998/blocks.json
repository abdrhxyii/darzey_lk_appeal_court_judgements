    "bbox": [
      65.77,
      307.06,
      535.11,
      325.47
    ],
    "text": "boundaries and the extent of the lands referred to in the deeds of the 1st defendant",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      12.194055557250977,
      13.800000190734863,
      14.399191856384277
    ]
  },
