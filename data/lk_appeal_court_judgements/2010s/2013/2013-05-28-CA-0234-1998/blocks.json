    "page_number": 4,
    "bbox": [
      65.63,
      339.7,
      534.2,
      358.11
    ],
    "text": "do not tally with that of the boundaries and the extent of the land sought to be",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      13.711868286132812,
      13.800000190734863,
      14.399191856384277
    ]
  },
