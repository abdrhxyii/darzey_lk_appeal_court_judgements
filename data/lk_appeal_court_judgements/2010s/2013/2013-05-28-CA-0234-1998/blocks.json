    "page_number": 4,
    "bbox": [
      65.86,
      469.3,
      534.46,
      487.71
    ],
    "text": "clear that three boundaries of the land shown in the plan marked 'X' and the deeds",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
