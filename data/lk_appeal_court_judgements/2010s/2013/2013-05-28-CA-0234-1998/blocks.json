    "bbox": [
      65.8,
      232.17,
      205.14,
      250.58
    ],
    "text": "sought to be partitioned.",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      13.800000190734863
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      160.55,
      274.66,
      534.35,
      293.08
    ],
    "text": "Submissions of the learned Counsel for the appellant is that the",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      13.533221244812012,
      13.800000190734863,
      14.399191856384277
    ]
  },
