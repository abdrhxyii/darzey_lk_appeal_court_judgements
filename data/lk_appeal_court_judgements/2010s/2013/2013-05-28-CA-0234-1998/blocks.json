      "Times-Roman"
    ],
    "sizes": [
      13.800000190734863
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      65.86,
      167.62,
      534.47,
      186.03
    ],
    "text": "looked at the evidence led in the case. I do not see any wrong on the part of the",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
