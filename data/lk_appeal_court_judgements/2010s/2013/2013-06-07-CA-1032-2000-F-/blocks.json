      "Times-Roman"
    ],
    "sizes": [
      13.600000381469727
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      70.3,
      435.91,
      531.72,
      454.06
    ],
    "text": "Attorney At Law was present before Court. It seems that the learned Additional",
    "fonts": [
      "Helvetica",
      "Times-Roman"
    ],
    "sizes": [
      13.600000381469727,
      13.683144569396973
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      70.5,
      459.68,
      532.08,
      477.82
    ],
    "text": "District Judge has misdirected himself in fixing the case for an ex parte trial after",
