    ]
  },
  {
    "page_number": 1,
    "bbox": [
      138.35,
      673.48,
      529.43,
      691.36
    ],
    "text": "The learned Additional District Judge has delivered a judgment in",
    "fonts": [
      "Times-Roman"
    ],
