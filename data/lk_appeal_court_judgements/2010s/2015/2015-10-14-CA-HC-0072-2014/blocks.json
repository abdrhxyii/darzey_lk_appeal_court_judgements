    "bbox": [
      63.74,
      109.76,
      528.06,
      129.28
    ],
    "text": "Further in King V. Athukorale 50 N.L.R 256 Justice Gratiaen states thus:-",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      13.450468063354492,
      13.891345977783203,
