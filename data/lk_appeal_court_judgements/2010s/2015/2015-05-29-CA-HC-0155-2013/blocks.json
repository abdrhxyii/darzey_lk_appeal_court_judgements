  },
  {
    "page_number": 1,
    "bbox": [
      62.72,
      179.24,
      537.45,
      219.73
    ],
    "text": "committing injuries to one Wannarachchilage Premaratne by throwing a hand grenade to him on or about 22nd July 2006 an offence punishable",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      9.380447387695312,
      13.882370948791504,
      14.005382537841797,
