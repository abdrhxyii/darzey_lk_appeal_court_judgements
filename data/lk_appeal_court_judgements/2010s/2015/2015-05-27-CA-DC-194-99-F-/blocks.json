    "bbox": [
      87.83,
      213.22,
      516.59,
      231.5
    ],
    "text": "would have been sufficient if writ had not been issued. But when it is",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      12.76207160949707,
      13.300000190734863,
      13.360462188720703,
      13.698918342590332,
      13.719581604003906,
      14.169526100158691
