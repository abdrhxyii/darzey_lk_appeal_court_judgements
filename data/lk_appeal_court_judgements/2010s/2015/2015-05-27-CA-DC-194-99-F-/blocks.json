      13.501326560974121,
      13.526176452636719,
      13.742779731750488
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      88.42,
      432.81,
      517.19,
      451.09
    ],
    "text": "appeat and the said appeal too had been dismissed by the said court.",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      13.300000190734863,
      13.372502326965332,
      13.53266429901123
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      87.99,
      460.65,
      518.23,
      478.93
    ],
    "text": "The fact that the defendant had appealed from the said order of the",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      13.300000190734863,
      13.372502326965332,
      13.482941627502441,
      13.742779731750488
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      88.25,
      480.58,
      519.3,
      598.21
    ],
    "text": "District Judge and the said appeal had been dismissed and the fact that the plaintiff has not appeal to the court of appeal from the order of the District Judge for failing to order re-possession to the defendants are not reasons to deny the right of the defendants for the re-possession of the said premises. The present application was made by the defendants are to obtain relief for the wrong committed on them.",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      13.122566223144531,
      13.300000190734863,
      13.340887069702148,
      13.360462188720703,
      13.372502326965332,
      13.417332649230957,
      13.433232307434082,
      13.452821731567383,
      13.526176452636719,
      13.60739803314209,
      13.635664939880371,
      13.742779731750488,
      13.768692016601562,
      13.876840591430664
    ]
  },
  {
    "page_number": 4,
    "bbox": [
