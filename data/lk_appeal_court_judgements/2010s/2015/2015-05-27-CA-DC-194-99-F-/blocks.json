      87.43,
      329.37,
      488.05,
      347.65
    ],
    "text": "Sansoni, J. in Sirinivasa Thero 63 N.L.R 31 at 34 stated as follows:-",
    "fonts": [
      "Helvetica",
      "Times-Roman"
    ],
    "sizes": [
      12.774675369262695,
