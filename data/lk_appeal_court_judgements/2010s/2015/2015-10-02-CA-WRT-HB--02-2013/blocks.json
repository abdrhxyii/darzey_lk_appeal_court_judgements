      12.234500885009766
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      51.86,
      443.06,
      550.56,
      458.53
    ],
    "text": "\"There is no-requirement that the Court of Appeal should first inquire into the question of custody",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727,
      11.642721176147461,
      11.78054428100586
