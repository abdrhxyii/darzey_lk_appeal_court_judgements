    "bbox": [
      52.21,
      587.77,
      550.31,
      603.25
    ],
    "text": "control of the respondents before the matter is referred to a judge of a court of First instance for",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727,
      11.916726112365723
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      52.21,
      608.66,
      149.44,
      624.13
    ],
