    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727
    ]
  },
  {
    "page_number": 4,
    "bbox": [
      52.51,
      638.9,
      551.08,
      654.37
    ],
    "text": "However we find that the petitioner himself did not place much reliance on the hearsay information",
    "fonts": [
      "Times-Roman"
