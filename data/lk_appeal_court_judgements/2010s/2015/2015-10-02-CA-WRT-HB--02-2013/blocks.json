    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727,
      11.78054428100586
    ]
  },
  {
    "page_number": 5,
    "bbox": [
      53.89,
      111.62,
      552.97,
      127.09
    ],
