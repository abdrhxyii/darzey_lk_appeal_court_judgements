      51.52,
      162.58,
      531.41,
      178.86
    ],
    "text": "In the case of Dahanayake and Others Vs. Sri Lanka Insurance Corporation Ltd. And Others",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
      11.600000381469727,
      11.78054428100586,
      12.078948974609375,
      12.199999809265137,
