      14.69446849822998
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      66.17,
      668.35,
      538.91,
      708.61
    ],
    "text": "has failed to consider and evaluate the discrepancy inter se arising from the evidence of Harini and her mother's evidence. According to the",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      13.516006469726562,
      13.922229766845703,
      14.100000381469727,
      14.179924011230469,
      14.446785926818848,
      14.69446849822998
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      65.47,
      71.71,
      534.18,
      91.09
    ],
    "text": "victim her mother was going to wake up the brother the accused-",
    "fonts": [
      "Helvetica"
