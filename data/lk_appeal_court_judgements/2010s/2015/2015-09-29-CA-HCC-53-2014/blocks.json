    ]
  },
  {
    "page_number": 1,
    "bbox": [
      60.4,
      646.08,
      533.26,
      678.59
    ],
    "text": "This case was tried by a Judge without a Jury upon the request of the second accused. At the conclusion of the trial on 25.02.2014 both accused were convicted by the learned",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      11.338400840759277,
      11.5006742477417,
      11.595699310302734,
      11.600000381469727,
      11.724926948547363,
      11.921154022216797
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      61.19,
      679.68,
      532.86,
      712.67
    ],
    "text": "High Court Judge for both the charges. The first accused was convicted in absentia as he was absconding to date.",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      10.826619148254395,
      11.354860305786133,
