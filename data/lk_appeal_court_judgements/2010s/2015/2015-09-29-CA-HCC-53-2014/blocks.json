      666.4
    ],
    "text": "However, according to the witness, she had never known the appellant before she came to the Magistrate's Court to give evidence. She had only known the name \"Dias\" before the case but not the appearance of the person (vide page 60 of the brief).",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      11.4357271194458,
      11.471528053283691,
      11.601479530334473,
      11.657388687133789,
      11.679282188415527,
      11.755666732788086,
      11.800000190734863,
      11.886086463928223,
      11.92978572845459,
      12.023484230041504
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      527.16,
      714.78,
      534.81,
      728.39
    ],
    "text": "3",
    "fonts": [
      "Times-Roman"
    ],
    "sizes": [
