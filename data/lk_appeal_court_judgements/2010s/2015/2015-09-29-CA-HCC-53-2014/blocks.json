      11.595699310302734,
      11.598350524902344,
      11.600000381469727,
      11.631706237792969,
      11.735113143920898,
      11.761377334594727,
      11.771236419677734,
      11.784926414489746,
      11.827911376953125,
      11.921154022216797
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      60.16,
      561.36,
      531.93,
      577.3
    ],
    "text": "The first accused was absconding and the learned Trial Judge decided to hold the trial in",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      11.433859825134277,
      11.571414947509766,
      11.600000381469727,
