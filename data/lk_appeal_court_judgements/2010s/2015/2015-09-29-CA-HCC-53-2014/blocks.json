    "bbox": [
      60.6,
      578.41,
      532.27,
      611.38
    ],
    "text": "absentia after considering all the evidence to the fact that the first accused was absconding under sec. 241 of the Code of Criminal Procedure.",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      11.277877807617188,
      11.571414947509766,
      11.592897415161133,
      11.600000381469727,
      11.631706237792969,
