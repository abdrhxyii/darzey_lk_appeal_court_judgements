    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      11.800000190734863
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      65.02,
      336.51,
      521.51,
      352.72
    ],
    "text": "who habitually quarrels with others after consuming liquor. While wasantha went",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      11.800000190734863,
      11.825323104858398
    ]
  },
  {
