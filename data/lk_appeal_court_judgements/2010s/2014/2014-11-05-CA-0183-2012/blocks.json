    "bbox": [
      65.03,
      271.95,
      522.12,
      288.16
    ],
    "text": "Lokka was in his compound after consuming alchohol. He had quarreled with a",
    "fonts": [
      "Helvetica"
    ],
    "sizes": [
      11.52325439453125,
      11.718820571899414,
